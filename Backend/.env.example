NODE_ENV=development
PORT=8000
MONGODB_URI=mongodb://127.0.0.1:27017
CORS_ORIGIN=http://localhost:5173
# generate each with: openssl rand -hex 48   (must be different, 32+ chars)
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# S3-Compatible Object Storage   (e.g. RustFS Book Vault on Docker / MinIO / AWS S3)
# Note: For local development, RustFS runs locally on the laptop at http://127.0.0.1:19000.
# Do NOT configure the deployed remote backend with localhost URLs.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:19000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=growth-os-books
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_MAX_FILE_BYTES=52428800
